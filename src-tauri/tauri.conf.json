{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horalix Web",
  "version": "0.1.0",
  "identifier": "com.horalix.web",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Horalix Web",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"]
  }
}
